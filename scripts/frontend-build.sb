(version 1)
(deny default)
(allow process-fork)
(allow process-exec)
(allow sysctl-read)
(allow mach-lookup)
(allow file-read-metadata)
(allow file-read-data (literal "/"))
(allow file-read* (subpath "/System/Library") (subpath "/usr/lib") (subpath "/usr/share") (literal "/usr/local/bin/node") (subpath "/Library/Apple") (subpath "/private/var/db/dyld") (subpath "/dev") (subpath (param "FRONTEND")))
(allow file-write* (subpath (param "FRONTEND")) (subpath (param "BUILD_TEMP")) (literal "/dev/null"))
(allow file-read* (subpath (param "BUILD_TEMP")))
(deny network*)
